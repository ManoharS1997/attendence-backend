pipeline {
    agent any

    environment {
        // Application
        PORT = '5000'
        NODE_ENV = 'production'

        // Database
        MONGO_URI = 'mongodb+srv://admin:4JZDAZz5gEOF9iBP@attendance.qtlgr7f.mongodb.net/attendance?retryWrites=true&w=majority'

        // Auth
        JWT_SECRET = 'supersecretjwtkey'

        // Default Users
        DEFAULT_ADMIN_EMAIL = 'admin@nowitservices.com'
        DEFAULT_ADMIN_PASSWORD = 'Admin@123'
        DEFAULT_MANAGER_EMAIL = 'manager@nowitservices.com'
        DEFAULT_MANAGER_PASSWORD = 'Manager@123'

        // Docker
        IMAGE_NAME = 'attendance-backend'
        CONTAINER_NAME = 'attendance-backend-container'
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo '📥 Cloning backend repository...'
                git branch: 'main',
                    url: 'https://github.com/ManoharS1997/attendence-backend.git'
            }
        }

        stage('Clean Old Docker Resources') {
            steps {
                sh '''
                    echo "🧹 Cleaning old containers and images..."
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker rmi ${IMAGE_NAME} || true
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "🐳 Building Docker image..."
                    docker build -t ${IMAGE_NAME} .
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                    echo "🚀 Running backend container..."
                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p ${PORT}:${PORT} \
                      -e PORT=${PORT} \
                      -e NODE_ENV=${NODE_ENV} \
                      -e MONGO_URI="${MONGO_URI}" \
                      -e JWT_SECRET="${JWT_SECRET}" \
                      -e DEFAULT_ADMIN_EMAIL="${DEFAULT_ADMIN_EMAIL}" \
                      -e DEFAULT_ADMIN_PASSWORD="${DEFAULT_ADMIN_PASSWORD}" \
                      -e DEFAULT_MANAGER_EMAIL="${DEFAULT_MANAGER_EMAIL}" \
                      -e DEFAULT_MANAGER_PASSWORD="${DEFAULT_MANAGER_PASSWORD}" \
                      ${IMAGE_NAME}
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Attendance backend deployed successfully!'
        }
        failure {
            echo '❌ Deployment failed!'
            sh 'docker logs ${CONTAINER_NAME} || true'
        }
        always {
            echo '🏁 Jenkins pipeline finished.'
        }
    }
}
