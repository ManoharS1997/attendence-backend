pipeline {
    agent any

    environment {
        PORT = '5000'
        NODE_ENV = 'production'

        IMAGE_NAME = 'attendance-backend'
        CONTAINER_NAME = 'attendance-backend-container'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ManoharS1997/attendance-backend.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Deploy Application') {
            environment {
                MONGO_URI = credentials('MONGO_URI')
                JWT_SECRET = credentials('JWT_SECRET')
                ADMIN_PASSWORD = credentials('ADMIN_PASSWORD')
                MANAGER_PASSWORD = credentials('MANAGER_PASSWORD')
            }
            steps {
                sh 'chmod +x scripts/*.sh'
                sh 'scripts/apply.sh'
            }
        }

        stage('Health Check') {
            steps {
                sh 'scripts/healthchecks.sh'
            }
        }
    }

    post {
        failure {
            sh 'scripts/rollback.sh'
        }
    }
}
